+    /**
+     * Root and Shizuku are capability boundaries, not merely command syntax.
+     * Every privileged local command therefore requires a fresh explicit user
+     * confirmation, even when the command itself looks read-only or harmless.
+     */
+    private suspend fun confirmPrivilegedIdentity(identity: String, command: String): String? {
+        if (identity != "root" && identity != "shizuku") return null
+
+        val ruleName = "Privileged ${identity.uppercase()} execution"
+        return when (
+            ToolPermissionCoordinator.confirm(
+                ToolPermissionRequest(
+                    id = UUID.randomUUID().toString(),
+                    toolName = name,
+                    command = command,
+                    matchedRuleName = ruleName,
+                    riskLevel = ToolPermissionRiskLevel.HIGH,
+                    executionIdentity = identity,
+                    reason = "The AI requested execution with elevated Android privileges.",
+                    reversible = null,
+                )
+            )
+        ) {
+            ToolPermissionResponse.ALLOWED -> null
+            ToolPermissionResponse.DENIED_BY_USER -> TerminalToolResponse.policyBlocked(
+                ShellCommandPolicyDecision(
+                    allowed = false,
+                    code = "PRIVILEGED_IDENTITY_DENIED",
+                    reason = "The user denied privileged $identity execution.",
+                    matchedRuleName = ruleName,
+                    matchedPattern = identity,
+                )
+            )
+            ToolPermissionResponse.DENIED_UNAVAILABLE -> TerminalToolResponse.policyBlocked(
